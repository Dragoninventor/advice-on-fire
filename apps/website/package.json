{
	"name": "@adviceonfire/website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dotenvx": "dotenvx",
		"dev": "dotenvx run -f .env.local -- next dev",
		"build": "SKIP_YARN_COREPACK_CHECK=0 dotenvx run -f .env.production -- next build --experimental-build-mode compile",
		"start": "dotenvx run --convention=nextjs -- next start",
		"lint": "dotenvx run --convention=nextjs -- next lint",
		"test": "dotenvx run --convention=nextjs -- vitest",
		"test:watch": "dotenvx run -- vitest --watch",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"encrypt-env": "cp .env.production.local .env.production && dotenvx encrypt -f .env.production"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.51.2",
		"@fortawesome/free-solid-svg-icons": "^7.1.0",
		"@fortawesome/react-fontawesome": "^3.1.1",
		"@payloadcms/db-mongodb": "^3.69.0",
		"@payloadcms/email-nodemailer": "^3.69.0",
		"@payloadcms/next": "^3.69.0",
		"@payloadcms/plugin-seo": "^3.69.0",
		"@payloadcms/richtext-lexical": "^3.69.0",
		"dotenv": "^17.2.3",
		"graphql": "^16.12.0",
		"lodash": "^4.17.21",
		"luxon": "^3.7.2",
		"next": "^16.1.0",
		"next-sitemap": "^4.2.3",
		"payload": "^3.69.0",
		"payload-plugin-comments": "^1.0.2",
		"qs": "^6.14.0",
		"react-icons": "^5.5.0",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@tailwindcss/language-server": "^0.14.29",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/escape-html": "^1.0.4",
		"@types/express": "^5.0.6",
		"@types/luxon": "^3.7.1",
		"@types/node": "^25",
		"@types/nodemailer": "^7.0.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"autoprefixer": "^10.4.23",
		"cross-env": "^10.1.0",
		"eslint": "^9",
		"eslint-config-next": "^16.1.0",
		"node": "^24.12.0",
		"postcss": "^8",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"sass": "^1.97.1",
		"tailwindcss": "^4.1.18",
		"ts-node": "^10.9.2",
		"typescript": "^5"
	},
	"packageManager": "npm@11.7.0"
}
